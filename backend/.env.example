# Copy this file to .env (gitignored) and fill in real values.

OPENAI_API_KEY=

# Optional - SMS reminders no-op safely without these
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Production only (deployment). Leave unset for local dev - safe defaults kick in.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# postgresql://user:password@host:5432/bluum - leave unset to use local SQLite
DATABASE_URL=
# Set to 0 in production (enables HTTPS-only cookies, requires SECRET_KEY, disables debug mode)
FLASK_DEBUG=1
