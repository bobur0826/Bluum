# Copy this file to .env (gitignored) and fill in real values.

OPENAI_API_KEY=

# Required for the Telegram Mini App login (/telegram, /telegram/auth) to work.
# Get this from @BotFather when you create the bot: /newbot -> copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# Required for proactive bot messages (evening check-in reminders, weekly summary)
# and their one-tap buttons to work. Your app's public HTTPS URL, no trailing
# slash - e.g. https://bluum-production.up.railway.app. The app registers
# {PUBLIC_BASE_URL}/telegram/webhook with Telegram automatically on startup.
# Leave unset for local dev - the webhook registration is silently skipped.
PUBLIC_BASE_URL=

# Optional - SMS reminders no-op safely without these
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Production only (deployment). Leave unset for local dev - safe defaults kick in.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# postgresql://user:password@host:5432/bluum - leave unset to use local SQLite
DATABASE_URL=
# Set to 0 in production (enables HTTPS-only cookies, requires SECRET_KEY, disables debug mode)
FLASK_DEBUG=1
