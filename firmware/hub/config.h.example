// Copy this file to config.h (gitignored) and fill in your own values.

#ifndef PINIT_CONFIG_H
#define PINIT_CONFIG_H

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Backend base URL, e.g. your laptop's LAN IP while the Flask dev server
// is running: "http://192.168.1.50:5000"
#define BACKEND_BASE_URL "http://192.168.1.50:5000"

// Must match PINIT_HUB_API_KEY in backend/.env (or the default in app.py)
#define HUB_API_KEY "dev-secret-change-me"

#endif
