# /etc/systemd/system/medpass.service
# Keeps gunicorn running, restarts on crash and on server reboot.

[Unit]
Description=MedPass gunicorn
After=network.target

[Service]
User=medpass
WorkingDirectory=/opt/medpass/backend
EnvironmentFile=/opt/medpass/backend/.env
ExecStart=/opt/medpass/backend/.venv/bin/gunicorn -w 4 -b 127.0.0.1:5001 app:app
Restart=always

[Install]
WantedBy=multi-user.target
